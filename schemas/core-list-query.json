{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lstutzman/wowbagger/schemas/core-list-query.json",
  "title": "list request, query version 1",
  "description": "The strict JSON request `list` reads from bounded stdin or a host-created request file. Query version 1 is its own version domain: a shape this core does not recognize is refused by `query_version`, not by the core contract version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_version",
    "as_of",
    "sort"
  ],
  "properties": {
    "query_version": {
      "const": 1
    },
    "as_of": {
      "$ref": "https://github.com/lstutzman/wowbagger/schemas/common.json#/$defs/isoDate"
    },
    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "direction"
      ],
      "properties": {
        "field": {
          "enum": [
            "created",
            "id",
            "number",
            "priority",
            "status",
            "title",
            "updated"
          ]
        },
        "direction": {
          "enum": [
            "ascending",
            "descending"
          ]
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "status": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://github.com/lstutzman/wowbagger/schemas/common.json#/$defs/status"
          }
        },
        "kind": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://github.com/lstutzman/wowbagger/schemas/common.json#/$defs/kind"
          }
        },
        "ready": {
          "type": "boolean"
        },
        "number": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "title_contains": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "A conjunction of closed filters. An empty or repeated array is invalid-request, never a silently widened query."
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "description": "An opaque cursor from a previous list response, replayed unchanged with the same query."
    }
  }
}
