{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lstutzman/wowbagger/schemas/core-list-error-response.json",
  "title": "list --json refusal responses",
  "description": "Every documented `list` refusal. A refusal never carries a partial page beside the error.",
  "type": "object",
  "oneOf": [
    {
      "title": "invalid-request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "contract_version",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "list"
        },
        "contract_version": {
          "const": 5
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "const": "invalid-request"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issues": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "https://github.com/lstutzman/wowbagger/schemas/common.json#/$defs/requestIssue"
                  }
                }
              },
              "required": [
                "issues"
              ]
            }
          },
          "required": [
            "code",
            "message",
            "details"
          ]
        }
      }
    },
    {
      "title": "ledger-invalid",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "contract_version",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "list"
        },
        "contract_version": {
          "const": 5
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "const": "ledger-invalid"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "validation_errors": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "https://github.com/lstutzman/wowbagger/schemas/common.json#/$defs/validationError"
                  }
                }
              },
              "required": [
                "validation_errors"
              ]
            }
          },
          "required": [
            "code",
            "message",
            "details"
          ]
        }
      }
    },
    {
      "title": "list-response-too-large",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "contract_version",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "list"
        },
        "contract_version": {
          "const": 5
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "const": "list-response-too-large"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max_list_response_bytes": {
                  "const": 131072
                },
                "response_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "page_size": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "max_list_response_bytes",
                "response_bytes",
                "page_size"
              ]
            }
          },
          "required": [
            "code",
            "message",
            "details"
          ]
        }
      }
    },
    {
      "title": "list-snapshot-changed",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "contract_version",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "list"
        },
        "contract_version": {
          "const": 5
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "const": "list-snapshot-changed"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mismatch": {
                  "enum": [
                    "snapshot",
                    "query"
                  ]
                },
                "cursor_snapshot_revision": {
                  "$ref": "https://github.com/lstutzman/wowbagger/schemas/common.json#/$defs/revision"
                },
                "current_snapshot_revision": {
                  "$ref": "https://github.com/lstutzman/wowbagger/schemas/common.json#/$defs/revision"
                }
              },
              "required": [
                "mismatch",
                "cursor_snapshot_revision",
                "current_snapshot_revision"
              ]
            }
          },
          "required": [
            "code",
            "message",
            "details"
          ]
        }
      }
    }
  ]
}
