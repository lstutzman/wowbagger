          "const": false
        },
        "command": {
          "const": "transition"
        },
        "contract_version": {
          "const": 5
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "const": "item-not-found"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "https://github.com/lstutzman/wowbagger/schemas/common.json#/$defs/itemId"
                }
              },
              "required": [
                "id"
              ]
