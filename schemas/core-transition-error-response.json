{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lstutzman/wowbagger/schemas/core-transition-error-response.json",
  "title": "transition --json refusal responses",
  "description": "Every documented `transition` refusal. Read `state` on every nonzero result: `unchanged` is a proven non-write, `unknown` establishes nothing, and `committed` means the item was written and something after publication failed.",
  "type": "object",
  "oneOf": [
    {
      "title": "invalid-request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "contract_version",
        "state",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "transition"
        },
        "contract_version": {
          "const": 5
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "const": "invalid-request"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issues": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "https://github.com/lstutzman/wowbagger/schemas/common.json#/$defs/requestIssue"
                  }
                }
              },
              "required": [
                "issues"
              ]
            }
          },
          "required": [
            "code",
            "message",
            "details"
          ]
        },
        "state": {
          "const": "unchanged"
        }
      }
    },
    {
      "title": "item-not-found",
      "type": "object",
      "additionalProperties": false,
