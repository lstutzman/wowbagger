{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lstutzman/wowbagger/schemas/bare-ready-result.json",
  "title": "ready --json success result",
  "description": "A bare result: no envelope, no command member, and no version field. An invalid ledger does not produce this shape; it produces the validation result, exit 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "as_of",
    "valid",
    "ready"
  ],
  "properties": {
    "as_of": {
      "$ref": "https://github.com/lstutzman/wowbagger/schemas/common.json#/$defs/isoDate"
    },
    "valid": {
      "const": true
    },
    "ready": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/lstutzman/wowbagger/schemas/common.json#/$defs/itemId"
      }
    }
  }
}
