{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lstutzman/wowbagger/schemas/report-config-v1.json",
  "title": "Report configuration, report_version 1",
  "description": "The `<ledger>/.wowbagger/report.json` a version 1 report reads. Version 1 names no views.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "report_version": {
      "const": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "logo": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\.([Ss][Vv][Gg]|[Pp][Nn][Gg]|[Jj][Pp][Gg]|[Jj][Pp][Ee][Gg]|[Ww][Ee][Bb][Pp])$",
          "description": "A configuration-relative image path with a supported extension."
        }
      },
      "required": [
        "name"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "description": "The configuration-relative artifact path. Required unless the invocation supplies --out."
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "area": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "tags": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "class": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "due": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "rank": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "score": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "complexity": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "tier": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "mandate": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "severity": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "confidence": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "security": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "priority_base": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "priority_component": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "priority_impact": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "priority_leverage": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "priority_rationale": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        },
        "completion_reference": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$"
        }
      },
      "description": "RFC 6901 pointers from the item document to a mapped report field."
    },
    "swarm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eligible_complexities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Requires fields.area and fields.complexity to be configured.",
      "required": [
        "eligible_complexities"
      ]
    }
  },
  "required": [
    "report_version",
    "repository",
    "title"
  ]
}
