{
  "adapter_vector_version": 1,
  "case": "mutation-approval",
  "coverage": [
    "authority"
  ],
  "targets": [
    "claude-code",
    "codex",
    "opencode",
    "kimi",
    "openai-compatible-harness"
  ],
  "mode": "negative-capability",
  "assertions": [
    {
      "id": "do-not-mutate-before-approval",
      "type": "approval-gate",
      "expect": "consumer-approval-required"
    },
    {
      "id": "do-not-grant-git-authority",
      "type": "approval-gate",
      "expect": "no-commit-or-push"
    },
    {
      "id": "do-not-advertise-approval-without-a-host-provider",
      "type": "approval-gate",
      "expect": "trusted-approval-unavailable"
    }
  ],
  "artifacts": [
    {
      "path": "approval-state.json",
      "sha256": "sha256:fd58af88824ceb78da59d58ec8b5f4989a38c6940a816b407aee9502752b763e"
    },
    {
