{
  "case": "envelope-domains",
  "fixture_version": 1,
  "status": "normative-envelope-rule",
  "description": "The one envelope rule: every --json response belongs to exactly one response domain, and a generic consumer dispatches on the root namespace member before it reads any version field. This manifest pins the domain, command member, version field, exit, state, error code, and exact root members of every response class the CLI emits.",
  "coverage": [
    "bare-result-commands",
    "core-mutation-contract",
    "claim-fenced-legacy-mutation",
    "claimed-publication",
    "dispatch-rule",
    "work-claim",
    "auto-commit-git-finalization"
  ],
  "dispatch_rule": {
    "steps": [
      "A response with a root namespace member belongs to the domain that member names.",
      "A response with no namespace member but a root ok member belongs to the core domain.",
      "A response with neither is a bare result; its command names its shape."
    ],
    "version_field_is_per_domain": true,
    "command_member_alone_is_ambiguous": true
  },
  "command_groups": [
    "claim"
  ],
