{
  "name": "wowbagger",
  "version": "0.1.0-alpha.7",
  "description": "Plain-Markdown, Git-native work ledger for coordinating agents — validate, ready-select, and mutate a task ledger from the CLI.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Lee Stutzman"
  },
  "homepage": "https://github.com/lstutzman/wowbagger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lstutzman/wowbagger.git"
  },
  "bugs": {
    "url": "https://github.com/lstutzman/wowbagger/issues"
  },
  "keywords": [
    "ledger",
    "task-management",
    "backlog",
    "coordination",
    "agent",
    "markdown",
    "git",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wowbagger": "bin/wowbagger.js"
  },
  "exports": {
    ".": "./src/launch.js",
    "./launch": "./src/launch.js",
    "./wowbagger.js": "./bin/wowbagger.js",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "adapters",
    "vendor",
    "docs/adapter-contract.md",
    "docs/mutation-contract.md",
    "docs/work-claim-contract.md",
    "scripts/migrate-schema-2.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "npm test && git diff --check && git diff --cached --check",
    "report": "node bin/wowbagger.js report --ledger ledger --json",
    "test": "node --test test/*.test.js",
    "release:cut": "node scripts/cut-release.js",
    "release:channels": "node scripts/release-channels.js",
    "prepublishOnly": "node bin/wowbagger.js validate --ledger ledger --json >/dev/null && node --check bin/wowbagger.js && node scripts/verify-release-tag.js"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
